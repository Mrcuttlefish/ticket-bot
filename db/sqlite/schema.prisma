generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DB_CONNECTION_URL")
}

model ArchivedChannel {
  channelId String
  createdAt DateTime @default(now())
  name      String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String

  @@id([ticketId, channelId])
  @@unique([ticketId, channelId])
  @@map("archivedChannels")
}

model ArchivedMessage {
  author    ArchivedUser @relation(fields: [ticketId, authorId], references: [ticketId, userId], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime     @default(now())
  deleted   Boolean      @default(false)
  edited    Boolean      @default(false)
  id        String       @id
  external  Boolean      @default(false)
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String

  @@map("archivedMessages")
}

model ArchivedRole {
  archivedUsers ArchivedUser[]
  colour        String         @default("5865F2") // 7289DA
  createdAt     DateTime       @default(now())
  name          String
  roleId        String
  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId      String

  @@id([ticketId, roleId])
  @@unique([ticketId, roleId])
  @@map("archivedRoles")
}

model ArchivedUser {
  archivedMessages ArchivedMessage[]
  avatar           String?
  bot              Boolean           @default(false)
  createdAt        DateTime          @default(now())
  discriminator    String?
  displayName      String?
  role             ArchivedRole?     @relation(fields: [ticketId, roleId], references: [ticketId, roleId], onDelete: Cascade)
  roleId           String?
  ticket           Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId         String
  userId           String
  username         String?

  @@id([ticketId, userId])
  @@unique([ticketId, userId])
  @@map("archivedUsers")
}

model Category {
  anonymous          Boolean    @default(false) // staff replies are relayed by the bot without their name
  archive            Boolean? // null: use the guild setting
  autoClose          Int? // seconds; null: use the guild setting, 0: off
  blockedRoles       String     @default("[]") // in addition to the guild blocklist
  buttonLabel        String? // panel button label; null: the category name
  buttonStyle        String? // PRIMARY, SECONDARY, SUCCESS or DANGER; null: the default
  channelName        String
  claimButton        Boolean? // null: use the guild setting
  claimedCategory    String? // Discord category to move claimed tickets to
  claimedChannelName String? // channel name while claimed; null: keep the name
  claimHide          Boolean    @default(true) // hide claimed tickets from the rest of the staff
  claiming           Boolean    @default(false)
  claimReleaseLocked Boolean    @default(false) // only the claimer (or a server manager) can release
  claimTakeover      Boolean    @default(false) // staff can take over a ticket someone else claimed
  closeButton        Boolean? // null: use the guild setting
  closedChannelName  String? // channel name while closed (kept channels); null: keep the name
  closedLimit        Int        @default(0) // closed tickets with kept channels a member can have; 0: no limit
  closedMessage      String? // added to the closed message and DM
  cooldown           Int? // seconds
  createdAt          DateTime   @default(now())
  creatorRoles       String     @default("{}") // { open|claim|close: { add: [], remove: [] } } for the creator
  customTopic        String?
  description        String
  discordCategory    String
  emoji              String
  enableFeedback     Boolean    @default(false)
  fallbackCategories String     @default("[]") // Discord categories to use when discordCategory is full
  guild              Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId            String
  id                 Int        @id @default(autoincrement())
  image              String?
  keepClosedFor      Int? // seconds to keep the channel after closing; null: delete at close, 0: until deleted
  memberLimit        Int        @default(1)
  name               String
  openDm             String? // DM to the creator when the ticket opens
  openingMessage     String
  openingStyle       String     @default("EMBED") // EMBED (or Components V2 if the guild uses it), TEXT, or OFF
  outOfHours         String     @default("WARN") // WARN or BLOCK new tickets outside working hours
  pingRoleRules      String     @default("[]") // [{ roles: [creator roles], ping: [roles to ping] }]
  pingRoles          String     @default("[]")
  questions          Question[]
  ratelimit          Int?
  reopenedMessage    String? // posted when the ticket is reopened
  requiredRoles      String     @default("[]")
  requireTopic       Boolean    @default(false)
  roleLimits         String     @default("[]") // [{ role, limit }] overrides memberLimit
  staffRoles         String
  staffThread        Boolean    @default(false) // private staff thread in each ticket
  staleAfter         Int? // seconds; null: use the guild setting, 0: off
  suggestTags        Boolean    @default(false) // suggest matching tags before a ticket is created (upstream #440)
  tickets            Ticket[]
  totalLimit         Int        @default(50)
  workingHours       String? // overrides the guild working hours; null: use the guild setting

  @@map("categories")
}

model Feedback {
  comment   String?
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId   String
  rating    Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String   @id
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@map("feedback")
}

model Guild {
  archive            Boolean    @default(true)
  autoClose          Int        @default(43200) // seconds
  autoTag            String     @default("[]")
  blocklist          String     @default("[]")
  buttons            String     @default("{}") // { [button]: { label, emoji, style } }
  categories         Category[]
  claimButton        Boolean    @default(false)
  closeButton        Boolean    @default(false)
  closeRequests      Boolean    @default(true)
  componentsV2       Boolean    @default(false) // send opening messages and panels with Discord's layout components (upstream #655)
  createdAt          DateTime   @default(now())
  errorColour        String     @default("Red")
  feedback           Feedback[]
  footer             String?    @default("Discord Tickets by eartharoid")
  ghostPing          Boolean    @default(false)
  holidays           String     @default("[]") // ["YYYY-MM-DD", ...] in the working hours timezone
  id                 String     @id
  locale             String     @default("en-GB")
  logChannel         String?
  logExclude         String     @default("[]") // events not sent to the log channel
  moveRelease        Boolean    @default(false) // /move releases claimed tickets
  moveResend         Boolean    @default(false) // /move sends the new category's opening message
  primaryColour      String     @default("#009999")
  staleAfter         Int? // seconds
  successColour      String     @default("Green")
  tags               Tag[]
  ticketNumberOffset Int        @default(0)
  tickets            Ticket[]
  transcriptChannel  String? // HTML transcripts are posted here when tickets close
  transcriptDm       Boolean    @default(false) // attach the HTML transcript to the closed DM
  userLimit          Int        @default(0) // open tickets per member across all categories; 0: no limit
  webhookSecret      String? // encrypted
  webhookUrl         String?
  workingHours       String     @default("[\"UTC\", [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"]]")

  @@map("guilds")
}

model Question {
  answers     QuestionAnswer[]
  createdAt   DateTime         @default(now())
  id          String           @id @default(uuid())
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int
  label       String
  maxLength   Int?             @default(4000)
  minLength   Int?             @default(0)
  options     String           @default("[]")
  order       Int
  placeholder String?
  required    Boolean          @default(true)
  style       Int              @default(2)
  type        String           @default("TEXT")
  value       String?

  @@map("questions")
}

model QuestionAnswer {
  createdAt  DateTime @default(now())
  id         Int      @id @default(autoincrement())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  value      String?

  @@map("questionAnswers")
}

model Tag {
  content        String
  createdAt      DateTime @default(now())
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId        String
  id             Int      @id @default(autoincrement())
  name           String
  preventedCount Int      @default(0) // tickets not opened because this tag solved the problem
  regex          String?

  @@unique([guildId, name])
  @@map("tags")
}

model Ticket {
  archivedChannels    ArchivedChannel[]
  archivedMessages    ArchivedMessage[]
  archivedRoles       ArchivedRole[]
  archivedUsers       ArchivedUser[]
  category            Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId          Int?
  claimedBy           User?             @relation(name: "TicketsClaimedByUser", fields: [claimedById], references: [id])
  claimedById         String?
  channelDeleteAt     DateTime? // when a kept closed channel is deleted
  closedAt            DateTime?
  closedBy            User?             @relation(name: "TicketsClosedByUser", fields: [closedById], references: [id])
  closedById          String?
  closedReason        String?
  createdAt           DateTime          @default(now())
  createdBy           User              @relation(name: "TicketsCreatedByUser", fields: [createdById], references: [id])
  createdById         String
  deleted             Boolean           @default(false)
  feedback            Feedback?
  firstResponseAt     DateTime?
  guild               Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId             String
  id                  String            @id
  lastMessageAt       DateTime?
  messageCount        Int?
  number              Int
  open                Boolean           @default(true)
  openingMessageId    String
  pinnedMessageIds    String            @default("[]")
  priority            String?
  referencedBy        Ticket[]          @relation("TicketsReferencedByTicket")
  referencesMessageId String?
  referencesTicket    Ticket?           @relation(name: "TicketsReferencedByTicket", fields: [referencesTicketId], references: [id], onDelete: SetNull)
  referencesTicketId  String?
  topic               String?
  questionAnswers     QuestionAnswer[]

  @@unique([guildId, number])
  @@map("tickets")
}

model User {
  createdAt       DateTime         @default(now())
  feedback        Feedback[]
  id              String           @id
  messageCount    Int              @default(0)
  ticketsCreated  Ticket[]         @relation("TicketsCreatedByUser")
  ticketsClosed   Ticket[]         @relation("TicketsClosedByUser")
  ticketsClaimed  Ticket[]         @relation("TicketsClaimedByUser")
  questionAnswers QuestionAnswer[]

  @@map("users")
}
