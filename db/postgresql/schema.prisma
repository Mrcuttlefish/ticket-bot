generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_CONNECTION_URL")
}

model ArchivedChannel {
  channelId String   @db.VarChar(19)
  createdAt DateTime @default(now())
  name      String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String   @db.VarChar(19)

  @@id([ticketId, channelId])
  @@unique([ticketId, channelId])
  @@map("archivedChannels")
}

model ArchivedMessage {
  author    ArchivedUser @relation(fields: [ticketId, authorId], references: [ticketId, userId], onDelete: Cascade)
  authorId  String       @db.VarChar(19)
  content   String       @db.Text
  createdAt DateTime     @default(now())
  deleted   Boolean      @default(false)
  edited    Boolean      @default(false)
  external  Boolean      @default(false)
  id        String       @id @db.VarChar(19)
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String       @db.VarChar(19)

  @@map("archivedMessages")
}

model ArchivedRole {
  archivedUsers ArchivedUser[]
  colour        String         @default("5865F2") @db.Char(6) // 7289DA 
  createdAt     DateTime       @default(now())
  name          String
  roleId        String         @db.VarChar(19)
  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId      String         @db.VarChar(19)

  @@id([ticketId, roleId])
  @@unique([ticketId, roleId])
  @@map("archivedRoles")
}

model ArchivedUser {
  archivedMessages ArchivedMessage[]
  avatar           String?
  bot              Boolean           @default(false)
  createdAt        DateTime          @default(now())
  discriminator    String?           @db.Char(4)
  displayName      String?           @db.Text
  role             ArchivedRole?     @relation(fields: [ticketId, roleId], references: [ticketId, roleId], onDelete: Cascade)
  roleId           String?           @db.VarChar(19)
  ticket           Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId         String            @db.VarChar(19)
  userId           String            @db.VarChar(19)
  username         String?           @db.Text

  @@id([ticketId, userId])
  @@unique([ticketId, userId])
  @@map("archivedUsers")
}

model Category {
  anonymous          Boolean    @default(false) // staff replies are relayed by the bot without their name
  archive            Boolean? // null: use the guild setting
  autoClose          Int? // seconds; null: use the guild setting, 0: off
  blockedRoles       Json       @default("[]") // in addition to the guild blocklist
  buttonLabel        String? // panel button label; null: the category name
  buttonStyle        String? // PRIMARY, SECONDARY, SUCCESS or DANGER; null: the default
  channelName        String
  claimButton        Boolean? // null: use the guild setting
  claimedCategory    String?    @db.VarChar(19) // Discord category to move claimed tickets to
  claimedChannelName String? // channel name while claimed; null: keep the name
  claimHide          Boolean    @default(true) // hide claimed tickets from the rest of the staff
  claiming           Boolean    @default(false)
  claimReleaseLocked Boolean    @default(false) // only the claimer (or a server manager) can release
  claimTakeover      Boolean    @default(false) // staff can take over a ticket someone else claimed
  closeButton        Boolean? // null: use the guild setting
  closedChannelName  String? // channel name while closed (kept channels); null: keep the name
  closedLimit        Int        @default(0) // closed tickets with kept channels a member can have; 0: no limit
  closedMessage      String?    @db.Text // added to the closed message and DM
  cooldown           Int? // seconds
  createdAt          DateTime   @default(now())
  creatorRoles       Json       @default("{}") // { open|claim|close: { add: [], remove: [] } } for the creator
  customTopic        String?
  description        String
  discordCategory    String     @db.VarChar(19)
  emoji              String
  enableFeedback     Boolean    @default(false)
  fallbackCategories Json       @default("[]") // Discord categories to use when discordCategory is full
  guild              Guild      @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId            String     @db.VarChar(19)
  id                 Int        @id @default(autoincrement())
  image              String?
  keepClosedFor      Int? // seconds to keep the channel after closing; null: delete at close, 0: until deleted
  memberLimit        Int        @default(1)
  name               String
  openDm             String?    @db.Text // DM to the creator when the ticket opens
  openingMessage     String     @db.Text
  openingStyle       String     @default("EMBED") // EMBED (or Components V2 if the guild uses it), TEXT, or OFF
  outOfHours         String     @default("WARN") // WARN or BLOCK new tickets outside working hours
  pingRoleRules      Json       @default("[]") // [{ roles: [creator roles], ping: [roles to ping] }]
  pingRoles          Json       @default("[]")
  questions          Question[]
  ratelimit          Int?
  reopenedMessage    String?    @db.Text // posted when the ticket is reopened
  requiredRoles      Json       @default("[]")
  requireTopic       Boolean    @default(false)
  roleLimits         Json       @default("[]") // [{ role, limit }] overrides memberLimit
  staffRoles         Json
  staffThread        Boolean    @default(false) // private staff thread in each ticket
  automations        Json       @default("[]") // [{ waitingOn: STAFF|CREATOR, after: seconds, action: CLOSE|TAG, tag? }]
  channelType        String     @default("CHANNEL") // CHANNEL, or THREAD for private threads in threadParent
  onCreatorLeave     String     @default("CLOSE") // CLOSE, KEEP or DELETE open tickets when the creator leaves
  threadParent       String?    @db.VarChar(19) // text channel that thread tickets are created in
  staleAfter         Int? // seconds; null: use the guild setting, 0: off
  suggestTags        Boolean    @default(false) // suggest matching tags before a ticket is created (upstream #440)
  tickets            Ticket[]
  totalLimit         Int        @default(50)
  workingHours       Json? // overrides the guild working hours; null: use the guild setting

  @@map("categories")
}

model Feedback {
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId   String   @db.VarChar(19)
  rating    Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String   @id @db.VarChar(19)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?  @db.VarChar(19)

  @@map("feedback")
}

model Guild {
  archive            Boolean    @default(true)
  autoClose          Int        @default(43200) // seconds
  autoTag            Json       @default("[]")
  blocklist          Json       @default("[]")
  buttons            Json       @default("{}") // { [button]: { label, emoji, style } }
  auditLogs          AuditLog[]
  dashboardRoles     Json       @default("[]") // roles that can change settings in the dashboard (not export or import)
  categories         Category[]
  claimButton        Boolean    @default(false)
  closeButton        Boolean    @default(false)
  closeRequests      Boolean    @default(true)
  componentsV2       Boolean    @default(false) // send opening messages and panels with Discord's layout components (upstream #655)
  createdAt          DateTime   @default(now())
  errorColour        String     @default("Red")
  feedback           Feedback[]
  footer             String?    @default("Discord Tickets by eartharoid")
  ghostPing          Boolean    @default(false)
  holidays           Json       @default("[]") // ["YYYY-MM-DD", ...] in the working hours timezone
  id                 String     @id @db.VarChar(19)
  locale             String     @default("en-GB")
  logChannel         String?    @db.VarChar(19)
  logExclude         Json       @default("[]") // events not sent to the log channel
  moveRelease        Boolean    @default(false) // /move releases claimed tickets
  moveResend         Boolean    @default(false) // /move sends the new category's opening message
  primaryColour      String     @default("#009999")
  staleAfter         Int? // seconds
  successColour      String     @default("Green")
  tags               Tag[]
  ticketNumberOffset Int        @default(0)
  tickets            Ticket[]
  transcriptChannel  String?    @db.VarChar(19) // HTML transcripts are posted here when tickets close
  transcriptDm       Boolean    @default(false) // attach the HTML transcript to the closed DM
  userLimit          Int        @default(0) // open tickets per member across all categories; 0: no limit
  webhookSecret      String?    @db.Text // encrypted
  webhookUrl         String?    @db.Text
  workingHours       Json       @default("[\"UTC\", [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"]]")

  @@map("guilds")
}

model Question {
  answers     QuestionAnswer[]
  createdAt   DateTime         @default(now())
  id          String           @id @default(uuid())
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int
  label       String           @db.VarChar(45)
  maxLength   Int?             @default(4000)
  minLength   Int?             @default(0)
  options     Json             @default("[]")
  order       Int
  placeholder String?          @db.VarChar(100)
  required    Boolean          @default(true)
  style       Int              @default(2)
  type        QuestionType     @default(TEXT)
  value       String?          @db.Text

  @@map("questions")
}

model QuestionAnswer {
  createdAt  DateTime @default(now())
  id         Int      @id @default(autoincrement())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId   String   @db.VarChar(19)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.VarChar(19)
  value      String?  @db.Text

  @@map("questionAnswers")
}

model Tag {
  content        String   @db.Text
  createdAt      DateTime @default(now())
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId        String   @db.VarChar(19)
  id             Int      @id @default(autoincrement())
  name           String
  preventedCount Int      @default(0) // tickets not opened because this tag solved the problem
  regex          String?
  autoDm         Boolean  @default(false) // auto-responses are sent to the author in a DM
  matchType      String   @default("REGEX") // REGEX, or WILDCARD (* and ?, the whole message)

  @@unique([guildId, name])
  @@map("tags")
}

model Ticket {
  archivedChannels    ArchivedChannel[]
  archivedMessages    ArchivedMessage[]
  archivedRoles       ArchivedRole[]
  archivedUsers       ArchivedUser[]
  category            Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId          Int?
  claimedBy           User?             @relation(name: "TicketsClaimedByUser", fields: [claimedById], references: [id])
  claimedById         String?           @db.VarChar(19)
  channelDeleteAt     DateTime? // when a kept closed channel is deleted
  closedAt            DateTime?
  closedBy            User?             @relation(name: "TicketsClosedByUser", fields: [closedById], references: [id])
  closedById          String?           @db.VarChar(19)
  closedReason        String?           @db.Text
  createdAt           DateTime          @default(now())
  createdBy           User              @relation(name: "TicketsCreatedByUser", fields: [createdById], references: [id])
  createdById         String            @db.VarChar(19)
  deleted             Boolean           @default(false)
  feedback            Feedback?
  firstResponseAt     DateTime?
  guild               Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId             String            @db.VarChar(19)
  id                  String            @id @db.VarChar(19)
  lastMessageAt       DateTime?
  automatedAt         DateTime? // when automations last ran for this ticket
  waitingOn           String? // STAFF or CREATOR: who should send the next message
  messageCount        Int?
  number              Int
  open                Boolean           @default(true)
  openingMessageId    String            @db.VarChar(19)
  pinnedMessageIds    Json              @default("[]")
  priority            TicketPriority?
  referencedBy        Ticket[]          @relation("TicketsReferencedByTicket")
  referencesMessageId String?           @db.VarChar(19)
  referencesTicket    Ticket?           @relation(name: "TicketsReferencedByTicket", fields: [referencesTicketId], references: [id], onDelete: SetNull)
  referencesTicketId  String?           @db.VarChar(19)
  topic               String?           @db.Text
  questionAnswers     QuestionAnswer[]

  @@unique([guildId, number])
  @@map("tickets")
}

model User {
  createdAt       DateTime         @default(now())
  feedback        Feedback[]
  id              String           @id @db.VarChar(19)
  messageCount    Int              @default(0)
  ticketsCreated  Ticket[]         @relation("TicketsCreatedByUser")
  ticketsClosed   Ticket[]         @relation("TicketsClosedByUser")
  ticketsClaimed  Ticket[]         @relation("TicketsClaimedByUser")
  questionAnswers QuestionAnswer[]

  @@map("users")
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum QuestionType {
  MENU
  TEXT
}

// settings changes made in the dashboard (Ticket Tool parity, P3)
model AuditLog {
  action     String // create, update or delete
  changes    Json? // [{ field, from, to }], with secrets left out
  createdAt  DateTime @default(now())
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId    String   @db.VarChar(19)
  id         Int      @id @default(autoincrement())
  targetId   String
  targetName String?
  targetType String
  userId     String   @db.VarChar(19)

  @@index([guildId, createdAt])
  @@map("audit_logs")
}
